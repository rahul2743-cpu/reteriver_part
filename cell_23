# ==========================================================
# CELL 23 — GRAPH-GROUNDED DOCUMENT RETRIEVAL
#           Ranked KG evidence → Document nodes → Content
# ==========================================================

print("=" * 80)
print("GRAPH-GROUNDED DOCUMENT RETRIEVAL")
print("=" * 80)


# ----------------------------------------------------------
# 0. Guards
# ----------------------------------------------------------

for _name in (
    "ranked_edges",
    "graph_evidence_df",
    "g",
    "docs",
    "EX",
    "RDFS",
    "node_label",
    "node_ref"
):
    assert _name in globals(), \
        f"{_name} is not defined. Run Cells 14, 18 and 22 first."


# ----------------------------------------------------------
# 1. Build document lookup by sourceReference
#
#    This allows a title-only entity/link node to resolve
#    back to the actual document node.
# ----------------------------------------------------------

documents_by_reference = defaultdict(list)

for doc in docs:

    ref = g.value(
        doc,
        EX.sourceReference
    )

    if ref is not None:

        documents_by_reference[
            str(ref)
        ].append(doc)


# ----------------------------------------------------------
# 2. Helper — get document content
# ----------------------------------------------------------

def get_document_content(doc_uri):

    content = g.value(
        doc_uri,
        EX.documentContent
    )

    if content is None:
        return None

    return str(content)


# ----------------------------------------------------------
# 3. Helper — resolve any KG node to documents
#
#    Case A:
#        Node itself is a document.
#
#    Case B:
#        Node is an entity/title-only node.
#        Use its reference to find the corresponding
#        document node.
# ----------------------------------------------------------

def resolve_node_to_documents(node_uri):

    node_uri = URIRef(node_uri)

    resolved_docs = []


    # ------------------------------------------------------
    # Case A — node itself is a document
    # ------------------------------------------------------

    if node_uri in docs:

        if get_document_content(node_uri):

            resolved_docs.append({
                "document": node_uri,
                "resolution": "direct_document"
            })


    # ------------------------------------------------------
    # Case B — title/entity node
    # ------------------------------------------------------

    else:

        ref = g.value(
            node_uri,
            EX.sourceReference
        )

        if ref is None:

            ref = g.value(
                node_uri,
                EX.targetReference
            )


        if ref is not None:

            matching_docs = documents_by_reference.get(
                str(ref),
                []
            )

            for doc_uri in matching_docs:

                if get_document_content(doc_uri):

                    resolved_docs.append({
                        "document": doc_uri,
                        "resolution": "reference_to_document"
                    })


    return resolved_docs


# ----------------------------------------------------------
# 4. Retrieve documents from ranked graph evidence
# ----------------------------------------------------------

document_candidates = {}

for edge in ranked_edges:

    target = edge["target"]

    resolved = resolve_node_to_documents(
        target
    )


    for item in resolved:

        doc_uri = item["document"]


        # --------------------------------------------------
        # Keep the strongest graph evidence for each document
        # --------------------------------------------------

        graph_score = float(
            edge["graph_score"]
        )


        if (
            doc_uri not in document_candidates
            or graph_score >
               document_candidates[doc_uri]["graph_score"]
        ):

            document_candidates[doc_uri] = {

                "document": doc_uri,

                "document_label": str(
                    g.value(
                        doc_uri,
                        RDFS.label
                    )
                    or doc_uri
                ),

                "reference": str(
                    g.value(
                        doc_uri,
                        EX.sourceReference
                    )
                    or ""
                ),

                "content": get_document_content(
                    doc_uri
                ),

                "graph_score": graph_score,

                "hop": edge["hop"],

                "root_seed": edge["root_seed"],

                "evidence_source": edge["source"],

                "evidence_target": edge["target"],

                "predicate": edge["predicate"],

                "edge_strength": edge["strength"],

                "resolution": item["resolution"]
            }


# ----------------------------------------------------------
# 5. Sort documents by strongest graph evidence
# ----------------------------------------------------------

retrieved_documents = sorted(
    document_candidates.values(),
    key=lambda x: (
        -x["graph_score"],
        x["hop"],
        -x["edge_strength"]
    )
)


# ----------------------------------------------------------
# 6. Display summary
# ----------------------------------------------------------

print()
print(f"Ranked graph edges        : {len(ranked_edges)}")
print(
    f"Unique documents retrieved: "
    f"{len(retrieved_documents)}"
)


# ----------------------------------------------------------
# 7. Display retrieved documents
# ----------------------------------------------------------

if retrieved_documents:

    document_df = pd.DataFrame([

        {
            "rank": i + 1,

            "document": d["document_label"],

            "graph_score": round(
                d["graph_score"],
                6
            ),

            "hop": d["hop"],

            "root_seed": node_label.get(
                d["root_seed"],
                str(d["root_seed"])
            ),

            "evidence_source": node_label.get(
                d["evidence_source"],
                str(d["evidence_source"])
            ),

            "evidence_target": node_label.get(
                d["evidence_target"],
                str(d["evidence_target"])
            ),

            "predicate": str(
                d["predicate"]
            ).rsplit("/", 1)[-1],

            "edge_strength": d[
                "edge_strength"
            ],

            "resolution": d[
                "resolution"
            ],

            "reference": d[
                "reference"
            ],

            "content_chars": len(
                d["content"] or ""
            )
        }

        for i, d in enumerate(
            retrieved_documents
        )
    ])


    print()
    print("RETRIEVED DOCUMENTS")
    print("-" * 80)

    display(
        document_df[
            [
                "rank",
                "document",
                "graph_score",
                "hop",
                "root_seed",
                "evidence_source",
                "evidence_target",
                "predicate",
                "edge_strength",
                "resolution",
                "content_chars"
            ]
        ].head(50)
    )


else:

    document_df = pd.DataFrame()

    print()
    print(
        "⚠️ No documents could be resolved "
        "from the ranked graph evidence."
    )


# ----------------------------------------------------------
# 8. Show a sample of actual document content
# ----------------------------------------------------------

print()
print("SAMPLE RETRIEVED DOCUMENT CONTENT")
print("=" * 80)


for i, doc in enumerate(
    retrieved_documents[:5],
    start=1
):

    print()
    print(
        f"[{i}] {doc['document_label']}"
    )

    print(
        f"Graph score : "
        f"{doc['graph_score']:.6f}"
    )

    print(
        f"Hop         : "
        f"{doc['hop']}"
    )

    print(
        f"Resolution  : "
        f"{doc['resolution']}"
    )

    print("-" * 80)

    content = doc["content"] or ""

    print(
        content[:1500]
    )

    if len(content) > 1500:
        print("\n...[content truncated for display]...")


print()
print("✅ Graph-grounded document retrieval completed.")
