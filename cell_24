# ==========================================================
# CELL 24 — DYNAMIC CHUNKING
#           Retrieved Documents -> Candidate Chunks
#
# Goal:
#   - Target at least 10 chunks
#   - Maximum chunk size = 250 characters
#   - Minimum chunk size = 80 characters
#   - Number of chunks can be > 10
#   - Do not add extra documents
#   - Do not duplicate chunks
# ==========================================================

print("=" * 80)
print("DYNAMIC DOCUMENT CHUNKING")
print("=" * 80)


# ==========================================================
# 1. VALIDATE REQUIRED VARIABLES
# ==========================================================

for _name in (
    "retrieved_documents",
    "tokenize"
):
    assert _name in globals(), \
        f"{_name} is not defined. Run the previous cells first."


# ==========================================================
# 2. CHUNKING CONFIGURATION
# ==========================================================

TARGET_CHUNKS    = 10
MAX_CHUNK_SIZE   = 250
MIN_CHUNK_SIZE   = 80


print()
print("CHUNKING CONFIGURATION")
print("-" * 80)

print(f"Target chunks       : {TARGET_CHUNKS}")
print(f"Maximum chunk size  : {MAX_CHUNK_SIZE}")
print(f"Minimum chunk size  : {MIN_CHUNK_SIZE}")


# ==========================================================
# 3. CALCULATE TOTAL RETRIEVED CONTENT
#
# IMPORTANT:
# Documents are NOT added here.
# We only use documents already retrieved by Cell 23.
# ==========================================================

total_content_chars = sum(
    len(doc["content"] or "")
    for doc in retrieved_documents
)


print()
print("RETRIEVED CONTENT")
print("-" * 80)

print(
    f"Retrieved documents : "
    f"{len(retrieved_documents)}"
)

print(
    f"Total characters    : "
    f"{total_content_chars}"
)


# ==========================================================
# 4. CALCULATE EFFECTIVE CHUNK SIZE
#
# Formula:
#
# total characters / target chunks
#
# Then constrain it between:
#
# MIN_CHUNK_SIZE and MAX_CHUNK_SIZE
#
# Example:
#
# 1068 chars / 10 = 106.8
# ceil = 107
#
# Effective chunk size = 107
#
# Example:
#
# 5000 chars / 10 = 500
# Maximum = 250
#
# Effective chunk size = 250
# ==========================================================

if total_content_chars > 0:

    calculated_chunk_size = math.ceil(
        total_content_chars / TARGET_CHUNKS
    )

    effective_chunk_size = min(
        MAX_CHUNK_SIZE,
        max(
            MIN_CHUNK_SIZE,
            calculated_chunk_size
        )
    )

else:

    calculated_chunk_size = MAX_CHUNK_SIZE
    effective_chunk_size = MAX_CHUNK_SIZE


print()
print("CHUNK SIZE CALCULATION")
print("-" * 80)

print(
    f"Calculated chunk size : "
    f"{calculated_chunk_size}"
)

print(
    f"Effective chunk size  : "
    f"{effective_chunk_size}"
)


# ==========================================================
# 5. CHUNKING FUNCTION
# ==========================================================

def split_document_into_chunks(
    text,
    chunk_size,
    min_chunk_size=MIN_CHUNK_SIZE
):
    """
    Split document into chunks using the effective
    chunk size.

    Rules:
    - Preserve paragraph boundaries where possible.
    - Split long paragraphs when necessary.
    - Merge very small chunks when possible.
    - Never duplicate content.
    """

    if not text:
        return []

    text = str(text).strip()

    if not text:
        return []


    # ------------------------------------------------------
    # Split into paragraphs
    # ------------------------------------------------------

    paragraphs = [
        p.strip()
        for p in text.split("\n")
        if p.strip()
    ]


    chunks = []
    current = ""


    # ------------------------------------------------------
    # Build chunks
    # ------------------------------------------------------

    for paragraph in paragraphs:

        if (
            len(current)
            + len(paragraph)
            + 1
            <= chunk_size
        ):

            if current:

                current += (
                    "\n" + paragraph
                )

            else:

                current = paragraph

            continue


        # --------------------------------------------------
        # Save current chunk
        # --------------------------------------------------

        if current:

            chunks.append(
                current.strip()
            )


        # --------------------------------------------------
        # Paragraph larger than chunk size
        # --------------------------------------------------

        if len(paragraph) > chunk_size:

            start = 0

            while start < len(paragraph):

                end = start + chunk_size

                piece = (
                    paragraph[start:end]
                    .strip()
                )

                if piece:

                    chunks.append(
                        piece
                    )

                start = end

            current = ""

        else:

            current = paragraph


    # ------------------------------------------------------
    # Add final chunk
    # ------------------------------------------------------

    if current:

        chunks.append(
            current.strip()
        )


    # ======================================================
    # Merge very small chunks
    # ======================================================

    final_chunks = []

    for chunk in chunks:

        if (
            len(chunk) < min_chunk_size
            and final_chunks
        ):

            merged = (
                final_chunks[-1]
                + "\n"
                + chunk
            )

            if (
                len(merged)
                <= chunk_size * 1.25
            ):

                final_chunks[-1] = merged

            else:

                final_chunks.append(
                    chunk
                )

        else:

            final_chunks.append(
                chunk
            )


    return final_chunks


# ==========================================================
# 6. CREATE CHUNKS FOR ALL RETRIEVED DOCUMENTS
# ==========================================================

chunk_records = []


for doc_rank, doc in enumerate(
    retrieved_documents,
    start=1
):

    document_text = (
        doc["content"] or ""
    ).strip()


    if not document_text:
        continue


    chunks = split_document_into_chunks(
        document_text,
        effective_chunk_size
    )


    for chunk_number, chunk_text in enumerate(
        chunks,
        start=1
    ):

        chunk_records.append({

            # ------------------------------------------
            # Document information
            # ------------------------------------------

            "document":
                doc["document"],

            "document_label":
                doc["document_label"],

            "reference":
                doc["reference"],


            # ------------------------------------------
            # Chunk information
            # ------------------------------------------

            "chunk_id":
                f"{doc_rank}_{chunk_number}",

            "chunk_number":
                chunk_number,

            "chunk_text":
                chunk_text,

            "chunk_chars":
                len(chunk_text),


            # ------------------------------------------
            # Graph evidence
            # ------------------------------------------

            "graph_score":
                float(
                    doc["graph_score"]
                ),

            "hop":
                int(
                    doc["hop"]
                ),

            "root_seed":
                doc["root_seed"],

            "evidence_source":
                doc["evidence_source"],

            "evidence_target":
                doc["evidence_target"],

            "predicate":
                doc["predicate"],

            "edge_strength":
                float(
                    doc["edge_strength"]
                ),

            "resolution":
                doc["resolution"]
        })


# ==========================================================
# 7. CREATE DATAFRAME
# ==========================================================

document_chunks = pd.DataFrame(
    chunk_records
)


# ==========================================================
# 8. TOKENIZE CHUNKS
# ==========================================================

if not document_chunks.empty:

    document_chunks["_tokens"] = (
        document_chunks["chunk_text"]
        .apply(tokenize)
    )

else:

    document_chunks["_tokens"] = []


# ==========================================================
# 9. CHUNK SUMMARY
# ==========================================================

print()
print("=" * 80)
print("CHUNKING SUMMARY")
print("=" * 80)

print(
    f"Retrieved documents    : "
    f"{len(retrieved_documents)}"
)

print(
    f"Total content chars    : "
    f"{total_content_chars}"
)

print(
    f"Effective chunk size   : "
    f"{effective_chunk_size}"
)

print(
    f"Target chunks          : "
    f"{TARGET_CHUNKS}"
)

print(
    f"Actual chunks created  : "
    f"{len(document_chunks)}"
)


# ==========================================================
# 10. MINIMUM CHUNK CHECK
# ==========================================================

if len(document_chunks) >= TARGET_CHUNKS:

    print()
    print(
        f"✅ Minimum chunk target satisfied: "
        f"{len(document_chunks)} >= {TARGET_CHUNKS}"
    )

else:

    print()
    print(
        f"⚠️ Only {len(document_chunks)} chunks "
        f"were created."
    )

    print(
        "The retrieved content is too small to produce "
        "10 chunks while respecting MIN_CHUNK_SIZE."
    )


# ==========================================================
# 11. CHUNKS PER DOCUMENT
# ==========================================================

if not document_chunks.empty:

    chunk_distribution = (
        document_chunks
        .groupby(
            "document_label"
        )
        .size()
        .reset_index(
            name="chunks"
        )
        .sort_values(
            "chunks",
            ascending=False
        )
    )

    print()
    print("CHUNKS PER DOCUMENT")
    print("-" * 80)

    display(
        chunk_distribution
    )


# ==========================================================
# 12. DISPLAY CHUNK METADATA
# ==========================================================

if not document_chunks.empty:

    print()
    print("DOCUMENT CHUNKS")
    print("-" * 80)

    display(
        document_chunks[
            [
                "chunk_id",
                "document_label",
                "chunk_number",
                "chunk_chars",
                "graph_score",
                "hop",
                "resolution"
            ]
        ]
    )

else:

    print()
    print(
        "⚠️ No chunks were created."
    )


# ==========================================================
# 13. SAMPLE CHUNK CONTENT
# ==========================================================

if not document_chunks.empty:

    print()
    print("=" * 80)
    print("SAMPLE CHUNK CONTENT")
    print("=" * 80)

    for _, row in document_chunks.head(10).iterrows():

        print()

        print(
            f"Chunk ID  : "
            f"{row['chunk_id']}"
        )

        print(
            f"Document  : "
            f"{row['document_label']}"
        )

        print(
            f"Characters: "
            f"{row['chunk_chars']}"
        )

        print("-" * 80)

        print(
            row["chunk_text"]
        )


print()
print(
    "✅ Dynamic chunking completed."
)
