import math
import re
import pandas as pd
from collections import defaultdict

from rdflib import URIRef, RDFS


# ============================================================
# 1. CONFIGURATION
# ============================================================

TARGET_CHUNKS = 10
MAX_CHUNK_SIZE = 250
MIN_CHUNK_SIZE = 80
OVERLAP_SIZE = 50


# ============================================================
# 2. VALIDATION
# ============================================================

required_vars = [
    "document_results",
    "g",
]

missing = [v for v in required_vars if v not in globals()]

if missing:
    raise RuntimeError(
        f"Missing required variables: {missing}"
    )


# ============================================================
# 3. GET DOCUMENT CONTENT
# ============================================================

def get_document_content(doc):
    """
    Extract document text from the document dictionary.
    """

    possible_fields = [
        "content",
        "document_content",
        "chunk_content",
        "text",
        "documentContent"
    ]

    for field in possible_fields:
        value = doc.get(field)

        if value:
            return str(value)

    return ""


# ============================================================
# 4. GET HUMAN-READABLE DOCUMENT TITLE
# ============================================================

def get_document_title(doc):
    """
    Get the human-readable title.

    Priority:
    1. Existing human-readable title
    2. KG rdfs:label using document/reference URI
    3. KG rdfs:label using title URI
    4. Unknown Title
    """

    KG_ENTITY_PREFIX = "http://knwbt.local/kg/entity/"

    # --------------------------------------------------------
    # 1. Check existing title fields
    # --------------------------------------------------------

    title_fields = [
        "document_title",
        "source_title",
        "label",
        "title"
    ]

    for field in title_fields:

        value = doc.get(field)

        if value:

            value = str(value).strip()

            # If already a human-readable title
            if value and not value.startswith(KG_ENTITY_PREFIX):
                return value


    # --------------------------------------------------------
    # 2. Try document/reference URI → KG rdfs:label
    # --------------------------------------------------------

    reference_fields = [
        "document_reference",
        "reference",
        "source_reference",
        "sourceReference",
        "source_node"
    ]

    for field in reference_fields:

        value = doc.get(field)

        if not value:
            continue

        try:

            node = URIRef(str(value))

            label = g.value(
                node,
                RDFS.label
            )

            if label:
                return str(label).strip()

        except Exception:
            pass


    # --------------------------------------------------------
    # 3. If title itself is a KG URI → KG rdfs:label
    # --------------------------------------------------------

    for field in [
        "title",
        "document_title"
    ]:

        value = doc.get(field)

        if not value:
            continue

        try:

            value = str(value).strip()

            if value.startswith(KG_ENTITY_PREFIX):

                node = URIRef(value)

                label = g.value(
                    node,
                    RDFS.label
                )

                if label:
                    return str(label).strip()

        except Exception:
            pass


    # --------------------------------------------------------
    # 4. Final fallback
    # --------------------------------------------------------

    return "Unknown Title"


# ============================================================
# 5. GET DOCUMENT REFERENCE
# ============================================================

def get_document_reference(doc):

    possible_fields = [
        "document_reference",
        "reference",
        "source_reference",
        "sourceReference",
        "source_node"
    ]

    for field in possible_fields:

        value = doc.get(field)

        if value:
            return str(value)

    return ""


# ============================================================
# 6. NORMALIZE TEXT
# ============================================================

def normalize_text(text):

    if not text:
        return ""

    text = str(text)

    # Normalize line breaks
    text = re.sub(r"\r\n?", "\n", text)

    # Remove excessive whitespace
    text = re.sub(r"[ \t]+", " ", text)

    # Normalize multiple newlines
    text = re.sub(r"\n{3,}", "\n\n", text)

    return text.strip()


# ============================================================
# 7. SPLIT TEXT INTO SENTENCE-AWARE UNITS
# ============================================================

def split_into_units(text, max_size):

    text = normalize_text(text)

    if not text:
        return []

    # --------------------------------------------------------
    # First split by paragraphs
    # --------------------------------------------------------

    paragraphs = re.split(
        r"\n\s*\n",
        text
    )

    units = []

    for paragraph in paragraphs:

        paragraph = paragraph.strip()

        if not paragraph:
            continue

        # ----------------------------------------------------
        # Sentence split
        # ----------------------------------------------------

        sentences = re.split(
            r"(?<=[.!?])\s+",
            paragraph
        )

        for sentence in sentences:

            sentence = sentence.strip()

            if not sentence:
                continue

            # ------------------------------------------------
            # If sentence fits, keep it
            # ------------------------------------------------

            if len(sentence) <= max_size:

                units.append(sentence)

                continue


            # ------------------------------------------------
            # Sentence too large → split by clauses
            # ------------------------------------------------

            clauses = re.split(
                r"(?<=[,;:])\s+",
                sentence
            )

            for clause in clauses:

                clause = clause.strip()

                if not clause:
                    continue

                if len(clause) <= max_size:

                    units.append(clause)

                    continue


                # --------------------------------------------
                # Clause still too large → word splitting
                # --------------------------------------------

                words = clause.split()

                current = ""

                for word in words:

                    if not current:

                        current = word

                    elif len(current) + 1 + len(word) <= max_size:

                        current += " " + word

                    else:

                        units.append(current.strip())

                        current = word

                if current:
                    units.append(current.strip())


    return units


# ============================================================
# 8. CREATE SENTENCE-AWARE CHUNKS
# ============================================================

def create_chunks(
    text,
    chunk_size,
    overlap_size
):

    units = split_into_units(
        text,
        chunk_size
    )

    if not units:
        return []

    chunks = []

    current_units = []
    current_length = 0

    for unit in units:

        unit_length = len(unit)

        # ----------------------------------------------------
        # Add unit to current chunk
        # ----------------------------------------------------

        if (
            current_units
            and
            current_length + 1 + unit_length > chunk_size
        ):

            chunk_text = " ".join(
                current_units
            ).strip()

            if chunk_text:
                chunks.append(chunk_text)


            # ------------------------------------------------
            # Create overlap using complete units
            # ------------------------------------------------

            overlap_units = []

            overlap_length = 0

            for previous_unit in reversed(current_units):

                if (
                    overlap_length
                    + len(previous_unit)
                    + (1 if overlap_units else 0)
                    <= overlap_size
                ):

                    overlap_units.insert(
                        0,
                        previous_unit
                    )

                    overlap_length = (
                        overlap_length
                        + len(previous_unit)
                        + (1 if overlap_units else 0)
                    )

                else:
                    break


            current_units = overlap_units.copy()

            current_length = sum(
                len(x)
                for x in current_units
            )

            if current_units:
                current_length += len(current_units) - 1


        # ----------------------------------------------------
        # Add current unit
        # ----------------------------------------------------

        current_units.append(unit)

        current_length = sum(
            len(x)
            for x in current_units
        ) + max(
            0,
            len(current_units) - 1
        )


    # --------------------------------------------------------
    # Add final chunk
    # --------------------------------------------------------

    if current_units:

        chunk_text = " ".join(
            current_units
        ).strip()

        if chunk_text:
            chunks.append(chunk_text)


    # --------------------------------------------------------
    # Merge extremely small final chunks
    # --------------------------------------------------------

    merged_chunks = []

    for chunk in chunks:

        if (
            merged_chunks
            and
            len(chunk) < MIN_CHUNK_SIZE
        ):

            combined = (
                merged_chunks[-1]
                + " "
                + chunk
            )

            if len(combined) <= MAX_CHUNK_SIZE:

                merged_chunks[-1] = combined

            else:

                merged_chunks.append(chunk)

        else:

            merged_chunks.append(chunk)


    return merged_chunks


# ============================================================
# 9. GET GRAPH SCORE
# ============================================================

def get_graph_score(doc):

    for field in [
        "graph_score",
        "graph_rank_score",
        "_graph_evidence"
    ]:

        value = doc.get(field)

        if value is not None:

            try:
                return float(value)
            except:
                pass

    return 0.0


# ============================================================
# 10. PREPARE DOCUMENTS
# ============================================================

documents = []

for doc in document_results:

    content = get_document_content(doc)

    if not content:
        continue

    title = get_document_title(doc)

    reference = get_document_reference(doc)

    graph_score = get_graph_score(doc)

    documents.append({
        "title": title,
        "reference": reference,
        "content": normalize_text(content),
        "graph_score": graph_score
    })


if not documents:

    raise RuntimeError(
        "No documents with content were found."
    )


# ============================================================
# 11. CALCULATE TOTAL CONTENT SIZE
# ============================================================

total_content_chars = sum(
    len(d["content"])
    for d in documents
)


calculated_chunk_size = math.ceil(
    total_content_chars / TARGET_CHUNKS
)


effective_chunk_size = min(
    MAX_CHUNK_SIZE,
    max(
        MIN_CHUNK_SIZE,
        calculated_chunk_size
    )
)


# ============================================================
# 12. DISPLAY CONTENT INFORMATION
# ============================================================

print("=" * 80)
print("CELL 24: DYNAMIC CHUNKING WITH 50-CHARACTER OVERLAP")
print("=" * 80)

print("\nCONTENT INFORMATION")
print("-" * 80)

print(
    f"Documents retrieved     : {len(documents)}"
)

print(
    f"Total content chars     : {total_content_chars}"
)

print(
    f"Calculated chunk size   : {calculated_chunk_size}"
)

print(
    f"Effective chunk size    : {effective_chunk_size}"
)

print(
    f"Maximum chunk size      : {MAX_CHUNK_SIZE}"
)

print(
    f"Minimum chunk size      : {MIN_CHUNK_SIZE}"
)

print(
    f"Overlap size            : {OVERLAP_SIZE}"
)


# ============================================================
# 13. CREATE ALL CANDIDATE CHUNKS
# ============================================================

document_chunks = []

for document in documents:

    chunks = create_chunks(
        document["content"],
        effective_chunk_size,
        OVERLAP_SIZE
    )

    for chunk_number, chunk_text in enumerate(
        chunks,
        start=1
    ):

        document_chunks.append({

            # Human-readable title
            "document_title":
                document["title"],

            # Original KG reference
            "document_reference":
                document["reference"],

            # Chunk number starts from 1
            "chunk_number":
                chunk_number,

            # Actual chunk
            "chunk_text":
                chunk_text,

            # Size
            "chunk_chars":
                len(chunk_text),

            # Graph evidence
            "graph_score":
                document["graph_score"],

            # Compatibility fields
            "hop": None,
            "resolution": None,

            # Tokens for Cell 25 MMR
            "_tokens":
                set(
                    re.findall(
                        r"\b[a-zA-Z0-9_]+\b",
                        chunk_text.lower()
                    )
                )
        })


# ============================================================
# 14. CHECK RESULT
# ============================================================

if not document_chunks:

    raise RuntimeError(
        "Chunking produced zero candidate chunks."
    )


# ============================================================
# 15. CREATE DATAFRAME
# ============================================================

chunks_df = pd.DataFrame(
    document_chunks
)


# ============================================================
# 16. CHUNKING SUMMARY
# ============================================================

print("\n" + "=" * 80)
print("CHUNKING RESULT")
print("=" * 80)

print(
    f"Documents processed : {len(documents)}"
)

print(
    f"Candidate chunks    : {len(document_chunks)}"
)


