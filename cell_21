# ==========================================================
# CELL 21 — SPARQL OUTGOING GRAPH TRAVERSAL
#           Seed → Hop 1 → Hop 2
# ==========================================================

print("=" * 80)
print("SPARQL OUTGOING GRAPH TRAVERSAL")
print("=" * 80)


# ----------------------------------------------------------
# 0. Guards
# ----------------------------------------------------------

for _name in (
    "seeds",
    "g",
    "PREFIXES",
    "MAX_HOPS",
    "MAX_FRONTIER",
    "MAX_EDGES",
    "MIN_EDGE_STRENGTH",
    "node_label"
):
    assert _name in globals(), \
        f"{_name} is not defined. Run the previous cells first."


# ----------------------------------------------------------
# 1. SPARQL query
#
#    The source node is supplied using RDFLib's
#    initBindings().
#
#    Therefore we do NOT insert the URI into the query.
# ----------------------------------------------------------

OUTGOING_QUERY = PREFIXES + """

SELECT
    ?source
    ?predicate
    ?target
    ?strength
    ?linkType
    ?description

WHERE {

    ?stmt a rdf:Statement ;

          rdf:subject    ?source ;

          rdf:predicate  ?predicate ;

          rdf:object     ?target ;

          ex:strength    ?strength ;

          ex:linkType    ?linkType ;

          ex:description ?description .
}
"""


# ----------------------------------------------------------
# 2. Get outgoing edges for ONE source node
# ----------------------------------------------------------

def get_outgoing_edges(source_uri):

    rows = list(
        g.query(
            OUTGOING_QUERY,
            initBindings={
                "source": URIRef(source_uri)
            }
        )
    )

    edges = []

    for row in rows:

        try:
            strength = float(row.strength)
        except (TypeError, ValueError):
            strength = 1.0

        if strength < MIN_EDGE_STRENGTH:
            continue

        edges.append({
            "source": URIRef(row.source),
            "target": URIRef(row.target),
            "predicate": URIRef(row.predicate),
            "strength": strength,
            "link_type": str(row.linkType),
            "description": str(row.description)
        })

    return edges


# ----------------------------------------------------------
# 3. Initialize traversal
# ----------------------------------------------------------

visited = set()

frontier = set()

root_seed = {}


for seed in seeds:

    uri = URIRef(seed["node"])

    frontier.add(uri)

    # Each seed is its own root seed
    root_seed[uri] = uri


# ----------------------------------------------------------
# 4. Store nodes discovered at every hop
# ----------------------------------------------------------

hop_nodes = {
    0: set(frontier)
}

traversed_edges = []


# ----------------------------------------------------------
# 5. Print initial seeds
# ----------------------------------------------------------

print()
print("INITIAL SEEDS")
print("-" * 80)

for i, seed in enumerate(seeds, start=1):

    print(
        f"{i}. {seed['label']} "
        f"(score={seed['score']:.4f})"
    )


# ----------------------------------------------------------
# 6. HOP-BY-HOP OUTGOING TRAVERSAL
# ----------------------------------------------------------

for hop in range(1, MAX_HOPS + 1):

    print()
    print("=" * 80)
    print(f"HOP {hop}")
    print("=" * 80)

    # Nothing left to expand
    if not frontier:

        print("Frontier is empty. Traversal stopped.")
        break


    next_candidates = []


    # ------------------------------------------------------
    # Expand ONLY the current frontier
    #
    # Hop 1:
    #     Seed → neighbors
    #
    # Hop 2:
    #     Hop-1 nodes → neighbors
    #
    # We never restart from the original seed.
    # ------------------------------------------------------

    for source in frontier:

        if len(traversed_edges) >= MAX_EDGES:
            break

        outgoing = get_outgoing_edges(source)


        for edge in outgoing:

            if len(traversed_edges) >= MAX_EDGES:
                break


            target = edge["target"]


            # --------------------------------------------------
            # Don't expand nodes that have already been visited
            # --------------------------------------------------

            if target in visited:
                continue


            # --------------------------------------------------
            # Preserve original seed
            # --------------------------------------------------

            edge["hop"] = hop

            edge["root_seed"] = root_seed[source]

            next_candidates.append(edge)


    # ------------------------------------------------------
    # Mark current frontier as visited
    # ------------------------------------------------------

    visited.update(frontier)


    # ------------------------------------------------------
    # If multiple sources reach the same target,
    # keep the strongest relationship.
    # ------------------------------------------------------

    best_by_target = {}


    for edge in next_candidates:

        target = edge["target"]

        if (
            target not in best_by_target
            or edge["strength"]
               > best_by_target[target]["strength"]
        ):
            best_by_target[target] = edge


    next_candidates = list(
        best_by_target.values()
    )


    # ------------------------------------------------------
    # Rank before applying MAX_FRONTIER
    #
    # Stronger relationships get priority.
    # ------------------------------------------------------

    next_candidates.sort(
        key=lambda e: -e["strength"]
    )


    # ------------------------------------------------------
    # Keep strongest MAX_FRONTIER nodes
    # ------------------------------------------------------

    next_candidates = next_candidates[:MAX_FRONTIER]


    # ------------------------------------------------------
    # Save discovered edges
    # ------------------------------------------------------

    traversed_edges.extend(
        next_candidates
    )


    # ------------------------------------------------------
    # Create next frontier
    # ------------------------------------------------------

    frontier = {
        edge["target"]
        for edge in next_candidates
    }


    hop_nodes[hop] = set(frontier)


    # ------------------------------------------------------
    # Print hop information
    # ------------------------------------------------------

    print(
        f"Nodes expanded        : "
        f"{len(hop_nodes[hop - 1])}"
    )

    print(
        f"New edges discovered   : "
        f"{len(next_candidates)}"
    )

    print(
        f"Next frontier size     : "
        f"{len(frontier)}"
    )


    # ------------------------------------------------------
    # Show sample relationships
    # ------------------------------------------------------

    if next_candidates:

        print()
        print("Sample discovered relationships:")
        print("-" * 80)


        for edge in next_candidates[:10]:

            source_label = node_label.get(
                edge["source"],
                str(edge["source"])
            )

            target_label = node_label.get(
                edge["target"],
                str(edge["target"])
            )

            predicate_label = str(
                edge["predicate"]
            ).rsplit("/", 1)[-1]


            print(
                f"  {source_label}"
                f" --[{predicate_label}]--> "
                f"{target_label}"
                f" | strength={edge['strength']}"
            )

    else:

        print(
            "No new outgoing relationships found."
        )


# ----------------------------------------------------------
# 7. Final traversal summary
# ----------------------------------------------------------

print()
print("=" * 80)
print("TRAVERSAL SUMMARY")
print("=" * 80)

print(f"Seeds                  : {len(seeds)}")
print(f"Maximum hops           : {MAX_HOPS}")
print(f"Maximum frontier       : {MAX_FRONTIER}")
print(f"Maximum edges          : {MAX_EDGES}")
print(f"Edges collected        : {len(traversed_edges)}")


for hop in sorted(hop_nodes):

    print(
        f"Hop {hop} nodes           : "
        f"{len(hop_nodes[hop])}"
    )


# ----------------------------------------------------------
# 8. Build traversal DataFrame
# ----------------------------------------------------------

if traversed_edges:

    traversal_df = pd.DataFrame([

        {
            "hop": edge["hop"],

            "root_seed": node_label.get(
                edge["root_seed"],
                str(edge["root_seed"])
            ),

            "source": node_label.get(
                edge["source"],
                str(edge["source"])
            ),

            "predicate": str(
                edge["predicate"]
            ).rsplit("/", 1)[-1],

            "target": node_label.get(
                edge["target"],
                str(edge["target"])
            ),

            "strength": edge["strength"],

            "link_type": edge["link_type"],

            "description": edge["description"]
        }

        for edge in traversed_edges
    ])


    print()
    print("TRAVERSAL EDGES")
    print("-" * 80)

    display(
        traversal_df[
            [
                "hop",
                "root_seed",
                "source",
                "predicate",
                "target",
                "strength",
                "link_type"
            ]
        ].head(50)
    )

else:

    traversal_df = pd.DataFrame()

    print()
    print(
        "⚠️ No outgoing graph relationships "
        "were discovered."
    )


print()
print("✅ Outgoing SPARQL traversal completed.")
