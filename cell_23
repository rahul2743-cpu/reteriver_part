                ),

            "predicate":
                (
                    str(
                        d["predicate"]
                    ).rsplit("/", 1)[-1]
                    if d["predicate"]
                    else "-"
                ),

            "edge_strength":
                d["edge_strength"],

            "resolution":
                d["resolution"],

            "content_chars":
                len(
                    d["content"] or ""
                )
        }

        for i, d in enumerate(
            retrieved_documents
        )

    ])

    print()
    print("RETRIEVED DOCUMENTS")
    print("-" * 80)

    display(
        document_df[
            [
                "rank",
