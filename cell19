def fuzzy_token_match(query_token, label_token):
    """Exact match, or spelling-tolerant match (difflib ratio >= MATCH_CUTOFF).
    Numbers must match exactly; very short words are not fuzzy-matched."""

    if query_token == label_token:
        return True

    if query_token.isdigit() or label_token.isdigit():
        return False

    if len(query_token) < 4 or len(label_token) < 4:
        return False

    ratio = difflib.SequenceMatcher(None, query_token, label_token).ratio()

    return ratio * 100 >= MATCH_CUTOFF


