                "root_seed",
                "evidence_source",
                "evidence_target",
                "predicate",
                "edge_strength",
                "resolution",
                "content_chars"
            ]
        ].head(50)
    )

else:

    document_df = pd.DataFrame()

    print()
    print(
        "⚠️ No documents were retrieved."
    )


