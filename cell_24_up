import math
import re
import pandas as pd


# ============================================================
# 1. CONFIGURATION
# ============================================================

TARGET_CHUNKS = 10
MAX_CHUNK_SIZE = 250
MIN_CHUNK_SIZE = 80
OVERLAP_SIZE = 50


# ============================================================
# 2. VALIDATION
# ============================================================

if "document_df" not in globals():
    raise RuntimeError(
        "Cell 23 output 'document_df' is not available. "
        "Run Cell 23 first."
    )

if "g" not in globals():
    raise RuntimeError(
        "Knowledge Graph 'g' is not available."
    )


# ============================================================
# 3. CONVERT CELL 23 OUTPUT TO RECORDS
# ============================================================

source_documents = document_df.to_dict("records")

if not source_documents:
    raise RuntimeError(
        "Cell 23 returned zero documents."
    )


# ============================================================
# 4. GET DOCUMENT TITLE
# ============================================================

def get_document_title(doc):

    # Cell 23 already provides the human-readable title
    if "document" in doc and pd.notna(doc["document"]):
        return str(doc["document"]).strip()

    # Fallbacks
    for field in [
        "document_title",
        "source_title",
        "title",
        "label"
    ]:
        if field in doc and pd.notna(doc[field]):
            return str(doc[field]).strip()

    return "Unknown Title"


# ============================================================
# 5. GET DOCUMENT CONTENT
# ============================================================

def get_document_content(doc):

    possible_fields = [
        "content",
        "document_content",
        "documentContent",
        "chunk_content",
        "text",
        "content_with_titles"
    ]

    for field in possible_fields:

        if field in doc and pd.notna(doc[field]):

            value = str(doc[field]).strip()

            if value:
                return value

    return ""


# ============================================================
# 6. GET DOCUMENT REFERENCE
# ============================================================

def get_document_reference(doc):

    possible_fields = [
        "reference",
        "document_reference",
        "source_reference",
        "sourceReference",
        "root_seed",
        "evidence_source"
    ]

    for field in possible_fields:

        if field in doc and pd.notna(doc[field]):

            value = str(doc[field]).strip()

            if value:
                return value

    return ""


# ============================================================
# 7. NORMALIZE TEXT
# ============================================================

def normalize_text(text):

    text = str(text)

    text = re.sub(
        r"\r\n?",
        "\n",
        text
    )

    text = re.sub(
        r"[ \t]+",
        " ",
        text
    )

    text = re.sub(
        r"\n{3,}",
        "\n\n",
        text
    )

    return text.strip()


# ============================================================
# 8. SENTENCE-AWARE SPLITTING
# ============================================================

def split_into_units(text, max_size):

    text = normalize_text(text)

    if not text:
        return []

    paragraphs = re.split(
        r"\n\s*\n",
        text
    )

    units = []

    for paragraph in paragraphs:

        paragraph = paragraph.strip()

        if not paragraph:
            continue

        # Sentence splitting
        sentences = re.split(
            r"(?<=[.!?])\s+",
            paragraph
        )

        for sentence in sentences:

            sentence = sentence.strip()

            if not sentence:
                continue

            # Sentence fits
            if len(sentence) <= max_size:

                units.append(sentence)

                continue

            # ------------------------------------------------
            # Large sentence → clause splitting
            # ------------------------------------------------

            clauses = re.split(
                r"(?<=[,;:])\s+",
                sentence
            )

            for clause in clauses:

                clause = clause.strip()

                if not clause:
                    continue

                if len(clause) <= max_size:

                    units.append(clause)

                    continue

                # --------------------------------------------
                # Large clause → word-level splitting
                # --------------------------------------------

                words = clause.split()

                current = ""

                for word in words:

                    if not current:

                        current = word

                    elif (
                        len(current)
                        + 1
                        + len(word)
                        <= max_size
                    ):

                        current += " " + word

                    else:

                        units.append(
                            current.strip()
                        )

                        current = word

                if current:

                    units.append(
                        current.strip()
                    )

    return units


# ============================================================
# 9. CREATE CHUNKS
# ============================================================

def create_chunks(
    text,
    chunk_size,
    overlap_size
):

    units = split_into_units(
        text,
        chunk_size
    )

    if not units:
        return []

    chunks = []

    current_units = []
    current_length = 0

    for unit in units:

        unit_length = len(unit)

        # ----------------------------------------------------
        # Current chunk is full
        # ----------------------------------------------------

        if (
            current_units
            and
            current_length
            + 1
            + unit_length
            > chunk_size
        ):

            chunk_text = " ".join(
                current_units
            ).strip()

            if chunk_text:
                chunks.append(chunk_text)

            # ------------------------------------------------
            # Sentence-aware overlap
            # ------------------------------------------------

            overlap_units = []
            overlap_length = 0

            for previous_unit in reversed(
                current_units
            ):

                extra = (
                    len(previous_unit)
                    + (1 if overlap_units else 0)
                )

                if (
                    overlap_length + extra
                    <= overlap_size
                ):

                    overlap_units.insert(
                        0,
                        previous_unit
                    )

                    overlap_length += extra

                else:
                    break

            current_units = overlap_units

            current_length = sum(
                len(x)
                for x in current_units
            )

            if current_units:

                current_length += (
                    len(current_units) - 1
                )

        # ----------------------------------------------------
        # Add unit
        # ----------------------------------------------------

        current_units.append(unit)

        current_length = sum(
            len(x)
            for x in current_units
        )

        current_length += (
            len(current_units) - 1
        )


    # --------------------------------------------------------
    # Final chunk
    # --------------------------------------------------------

    if current_units:

        chunk_text = " ".join(
            current_units
        ).strip()

        if chunk_text:
            chunks.append(chunk_text)


    # --------------------------------------------------------
    # Merge very small chunks
    # --------------------------------------------------------

    merged_chunks = []

    for chunk in chunks:

        if (
            merged_chunks
            and
            len(chunk) < MIN_CHUNK_SIZE
        ):

            combined = (
                merged_chunks[-1]
                + " "
                + chunk
            )

            if len(combined) <= MAX_CHUNK_SIZE:

                merged_chunks[-1] = combined

            else:

                merged_chunks.append(chunk)

        else:

            merged_chunks.append(chunk)

    return merged_chunks


# ============================================================
# 10. PREPARE DOCUMENTS
# ============================================================

documents = []

for doc in source_documents:

    title = get_document_title(doc)

    content = get_document_content(doc)

    reference = get_document_reference(doc)

    if not content:
        print(
            f"WARNING: No content found for '{title}'"
        )
        continue

    documents.append({

        "title": title,

        "reference": reference,

        "content": normalize_text(content),

        "graph_score": float(
            doc.get(
                "graph_score",
                0.0
            )
        )
    })


# ============================================================
# 11. VALIDATE DOCUMENT CONTENT
# ============================================================

if not documents:

    raise RuntimeError(
        "No document content found in Cell 23 output."
    )


# ============================================================
# 12. CALCULATE CHUNK SIZE
# ============================================================

total_content_chars = sum(
    len(d["content"])
    for d in documents
)

calculated_chunk_size = math.ceil(
    total_content_chars / TARGET_CHUNKS
)

effective_chunk_size = min(
    MAX_CHUNK_SIZE,
    max(
        MIN_CHUNK_SIZE,
        calculated_chunk_size
    )
)


# ============================================================
# 13. DISPLAY CONTENT INFORMATION
# ============================================================

print("=" * 80)
print("CELL 24: DYNAMIC CHUNKING WITH 50-CHARACTER OVERLAP")
print("=" * 80)

print("\nCONTENT INFORMATION")
print("-" * 80)

print(
    f"Documents retrieved     : {len(documents)}"
)

print(
    f"Total content chars     : {total_content_chars}"
)

print(
    f"Calculated chunk size   : {calculated_chunk_size}"
)

print(
    f"Effective chunk size    : {effective_chunk_size}"
)

print(
    f"Maximum chunk size      : {MAX_CHUNK_SIZE}"
)

print(
    f"Minimum chunk size      : {MIN_CHUNK_SIZE}"
)

print(
    f"Overlap size            : {OVERLAP_SIZE}"
)


# ============================================================
# 14. CREATE CANDIDATE CHUNKS
# ============================================================

document_chunks = []

for document in documents:

    chunks = create_chunks(
        document["content"],
        effective_chunk_size,
        OVERLAP_SIZE
    )

    for chunk_number, chunk_text in enumerate(
        chunks,
        start=1
    ):

        document_chunks.append({

            # Human-readable title
            "document_title":
                document["title"],

            # Original reference
            "document_reference":
                document["reference"],

            # Chunk number starts from 1
            "chunk_number":
                chunk_number,

            # Chunk text
            "chunk_text":
                chunk_text,

            # Character count
            "chunk_chars":
                len(chunk_text),

            # Graph score from Cell 23
            "graph_score":
                document["graph_score"],

            # Compatibility fields
            "hop": None,
            "resolution": None,

            # Tokens for Cell 25 MMR
            "_tokens": set(
                re.findall(
                    r"\b[a-zA-Z0-9_]+\b",
                    chunk_text.lower()
                )
            )
        })


# ============================================================
# 15. VALIDATE CHUNKS
# ============================================================

if not document_chunks:

    raise RuntimeError(
        "Chunking produced zero candidate chunks."
    )


# ============================================================
# 16. DATAFRAME
# ============================================================

chunks_df = pd.DataFrame(
    document_chunks
)


# ============================================================
# 17. CHUNKING RESULT
# ============================================================

print("\n" + "=" * 80)
print("CHUNKING RESULT")
print("=" * 80)

print(
    f"Documents processed : {len(documents)}"
)

print(
    f"Candidate chunks    : {len(document_chunks)}"
)


