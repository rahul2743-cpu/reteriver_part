# ==========================================================
# CELL 22 — GRAPH EVIDENCE RANKING
# ==========================================================

import networkx as nx
import pandas as pd

print("=" * 80)
print("GRAPH EVIDENCE RANKING")
print("=" * 80)


# ----------------------------------------------------------
# 1. Check Cell 21 output
# ----------------------------------------------------------

assert "reached" in globals(), "Run Cell 21 first."
assert "all_edges" in globals(), "Run Cell 21 first."
assert "g" in globals(), "KG graph 'g' is not defined."
assert "RDF" in globals(), "RDF is not defined."
assert "EX" in globals(), "EX is not defined."
assert "node_label" in globals(), "node_label is not defined."
assert "node_content" in globals(), "node_content is not defined."


# ----------------------------------------------------------
# 2. Build weighted KG
# ----------------------------------------------------------

D = nx.DiGraph()

for stmt in g.subjects(RDF.type, RDF.Statement):

    source = g.value(stmt, RDF.subject)
    target = g.value(stmt, RDF.object)

    if source is None or target is None:
        continue

    try:
        strength = float(g.value(stmt, EX.strength) or 1)
    except (TypeError, ValueError):
        strength = 1.0

    if D.has_edge(source, target):
        D[source][target]["weight"] = max(
            D[source][target]["weight"],
            strength
        )
    else:
        D.add_edge(
            source,
            target,
            weight=strength
        )


# ----------------------------------------------------------
# 3. PageRank
# ----------------------------------------------------------

pagerank = nx.pagerank(
    D,
    alpha=0.85,
    weight="weight"
)

print(
    f"KG nodes / edges : "
    f"{D.number_of_nodes()} / {D.number_of_edges()}"
)


# ----------------------------------------------------------
# 4. Normalize PageRank
# ----------------------------------------------------------

max_pr = max(
    (pagerank.get(node, 0.0) for node in reached),
    default=0.0
)

max_pr = max(max_pr, 1e-12)

IMPORTANCE_WEIGHT = 0.25


def importance(node):

    pr_norm = pagerank.get(node, 0.0) / max_pr

    return (
        1.0 + IMPORTANCE_WEIGHT * pr_norm
    ) / (
        1.0 + IMPORTANCE_WEIGHT
    )


# ----------------------------------------------------------
# 5. Rank reached nodes
# ----------------------------------------------------------

ranked_nodes = []

for node, info in reached.items():

    imp = importance(node)

    ranked_nodes.append({

        "node": node,

        "label": node_label.get(
            node,
            str(node)
        ),

        "hop": info["hop"],

        "root_seed": info["root_seed"],

        "parent": info["parent"],

        "predicate": info.get(
            "predicate"
        ),

        "strength": info.get(
            "strength"
        ),

        "base_score": info["graph_score"],

        "pagerank": pagerank.get(
            node,
            0.0
        ),

        "importance": imp,

        "graph_rank_score":
            info["graph_score"] * imp,

        "has_text":
            node in node_content
    })


# ----------------------------------------------------------
# 6. Sort nodes
# ----------------------------------------------------------

ranked_nodes.sort(
    key=lambda x: (
        -x["graph_rank_score"],
        x["hop"],
        x["label"]
    )
)

for i, node in enumerate(
    ranked_nodes,
    start=1
):
    node["rank"] = i


# ----------------------------------------------------------
# 7. Rank relationships
# ----------------------------------------------------------

ranked_edges = []

for edge in all_edges:

    imp = importance(
        edge["target"]
    )

    ranked_edges.append({

        "hop": edge["hop"],

        "root_seed":
            edge["root_seed"],

        "source":
            edge["source"],

        "target":
            edge["target"],

        "predicate":
            edge["predicate"],

        "strength":
            edge["strength"],

        "base_score":
            edge["graph_score"],

        "importance":
            imp,

        "graph_rank_score":
            edge["graph_score"] * imp,

        "description":
            edge.get(
                "description",
                ""
            )
    })


ranked_edges.sort(
    key=lambda x: (
        -x["graph_rank_score"],
        x["hop"],
        -x["strength"]
    )
)

for i, edge in enumerate(
    ranked_edges,
    start=1
):
    edge["rank"] = i


# ----------------------------------------------------------
# 8. Node table
# ----------------------------------------------------------

graph_nodes_df = pd.DataFrame([

    {
        "rank":
            n["rank"],

        "label":
            n["label"],

        "hop":
            n["hop"],

        "root_seed":
            node_label.get(
                n["root_seed"],
                str(n["root_seed"])
            ),

        "via":
            node_label.get(
                n["parent"],
                "-"
            )
            if n["parent"] is not None
            else "-",

        "predicate":
            str(n["predicate"]).rsplit("/", 1)[-1]
            if n["predicate"]
            else "-",

        "strength":
            n["strength"]
            if n["strength"] is not None
            else "-",

        "base_score":
            round(
                n["base_score"],
                4
            ),

        "pagerank":
            round(
                n["pagerank"],
                6
            ),

        "importance":
            round(
                n["importance"],
                4
            ),

        "graph_rank_score":
            round(
                n["graph_rank_score"],
                4
            ),

        "has_text":
            n["has_text"]
    }

    for n in ranked_nodes
])


# ----------------------------------------------------------
# 9. Relationship table
# ----------------------------------------------------------

graph_evidence_df = pd.DataFrame([

    {
        "rank":
            e["rank"],

        "hop":
            e["hop"],

        "source":
            node_label.get(
                e["source"],
                str(e["source"])
            ),

        "predicate":
            str(
                e["predicate"]
            ).rsplit("/", 1)[-1],

        "target":
            node_label.get(
                e["target"],
                str(e["target"])
            ),

        "strength":
            e["strength"],

        "base_score":
            round(
                e["base_score"],
                4
            ),

        "importance":
            round(
                e["importance"],
                4
            ),

        "graph_rank_score":
            round(
                e["graph_rank_score"],
                4
            )
    }

    for e in ranked_edges
])


# ----------------------------------------------------------
# 10. Display
# ----------------------------------------------------------

print()
print(
    f"Ranked nodes          : "
    f"{len(ranked_nodes)}"
)

print(
    f"Ranked relationships  : "
    f"{len(ranked_edges)}"
)

print()
print("RANKED GRAPH NODES")
print("-" * 80)

if not graph_nodes_df.empty:
    display(
        graph_nodes_df.head(50)
    )


print()
print("RANKED RELATIONSHIPS")
print("-" * 80)

if not graph_evidence_df.empty:
    display(
        graph_evidence_df.head(50)
    )
else:
    print(
        "No graph relationships found."
    )


# ----------------------------------------------------------
# 11. Hop summary
# ----------------------------------------------------------

print()
print("HOP SUMMARY")
print("-" * 80)

for hop in sorted(
    set(
        n["hop"]
        for n in ranked_nodes
    )
):

    count = sum(
        n["hop"] == hop
        for n in ranked_nodes
    )

    with_text = sum(
        n["hop"] == hop
        and n["has_text"]
        for n in ranked_nodes
    )

    print(
        f"Hop {hop}: "
        f"{count} nodes "
        f"({with_text} with text)"
    )


print()
print("✅ Graph evidence ranking completed.")
