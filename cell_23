# ==========================================================
# CELL 23 — GRAPH-GROUNDED DOCUMENT RETRIEVAL
#           KG Nodes / Graph Evidence -> Documents
#           Fetch actual document content
# ==========================================================

print("=" * 80)
print("GRAPH-GROUNDED DOCUMENT RETRIEVAL")
print("=" * 80)


# ==========================================================
# 1. VALIDATE REQUIRED VARIABLES
# ==========================================================

for _name in (
    "g",
    "docs",
    "seeds",
    "ranked_edges",
    "EX",
    "RDFS",
    "RDF",
    "node_label"
):
    assert _name in globals(), \
        f"{_name} is not defined. Run the previous cells first."


# ==========================================================
# 2. BUILD DOCUMENT INDEX
#
# Each document has:
#
#     rdf:type            -> ex:Document
#     rdfs:label          -> document title
#     ex:sourceReference  -> original reference
#     ex:documentContent  -> full document text
# ==========================================================

documents_by_reference = defaultdict(list)
documents_by_title = defaultdict(list)

for doc_uri in docs:

    # ------------------------------------------
    # Reference index
    # ------------------------------------------

    source_reference = g.value(
        doc_uri,
        EX.sourceReference
    )

    if source_reference is not None:

        documents_by_reference[
            str(source_reference).strip()
        ].append(doc_uri)

    # ------------------------------------------
    # Title index
    # ------------------------------------------

    document_label = g.value(
        doc_uri,
        RDFS.label
    )

    if document_label is not None:

        documents_by_title[
            str(document_label).strip().lower()
        ].append(doc_uri)


print()
print("DOCUMENT INDEX")
print("-" * 80)

print(
    f"Document nodes       : {len(docs)}"
)

print(
    f"Reference index size : "
    f"{len(documents_by_reference)}"
)

print(
    f"Title index size     : "
    f"{len(documents_by_title)}"
)


# ==========================================================
# 3. HELPER — GET DOCUMENT CONTENT
# ==========================================================

def get_document_content(doc_uri):

    content = g.value(
        doc_uri,
        EX.documentContent
    )

    if content is None:
        return None

    return str(content)


# ==========================================================
# 4. HELPER — RESOLVE A KG NODE TO DOCUMENT(S)
#
# A node can resolve to a document in several ways:
#
#   A. Node itself is a Document
#   B. Node has targetReference
#   C. Node has sourceReference
#   D. Node label matches a document title
# ==========================================================

def resolve_node_to_documents(node_uri):

    node_uri = URIRef(node_uri)

    resolved = {}

    # ------------------------------------------------------
    # A. NODE ITSELF IS A DOCUMENT
    # ------------------------------------------------------

    if (
        node_uri,
        RDF.type,
        EX.Document
    ) in g:

        content = get_document_content(
            node_uri
        )

        if content:

            resolved[node_uri] = {
                "document": node_uri,
                "resolution": "direct_document"
            }


    # ------------------------------------------------------
    # B. TARGET REFERENCE
    # ------------------------------------------------------

    target_reference = g.value(
        node_uri,
        EX.targetReference
    )

    if target_reference is not None:

        reference = str(
            target_reference
        ).strip()

        for doc_uri in documents_by_reference.get(
            reference,
            []
        ):

            if get_document_content(doc_uri):

                resolved[doc_uri] = {
                    "document": doc_uri,
                    "resolution": "target_reference"
                }


    # ------------------------------------------------------
    # C. SOURCE REFERENCE
    # ------------------------------------------------------

    source_reference = g.value(
        node_uri,
        EX.sourceReference
    )

    if source_reference is not None:

        reference = str(
            source_reference
        ).strip()

        for doc_uri in documents_by_reference.get(
            reference,
            []
        ):

            if get_document_content(doc_uri):

                resolved[doc_uri] = {
                    "document": doc_uri,
                    "resolution": "source_reference"
                }


    # ------------------------------------------------------
    # D. TITLE MATCH
    # ------------------------------------------------------

    node_title = g.value(
        node_uri,
        RDFS.label
    )

    if node_title is not None:

        title = str(
            node_title
        ).strip().lower()

        for doc_uri in documents_by_title.get(
            title,
            []
        ):

            if get_document_content(doc_uri):

                resolved[doc_uri] = {
                    "document": doc_uri,
                    "resolution": "title_match"
                }


    return list(
        resolved.values()
    )


# ==========================================================
# 5. DOCUMENT CANDIDATES
# ==========================================================

document_candidates = {}


# ==========================================================
# 6. FIRST — ADD DOCUMENTS REPRESENTED BY THE SEEDS
#
# Example:
#
# Query
#   ↓
# Service Operation
#   ↓
# Service Operation document
#
# The seed itself can therefore be a retrieved document.
# ==========================================================

for seed in seeds:

    seed_uri = URIRef(
        seed["node"]
    )

    resolved_documents = (
        resolve_node_to_documents(
            seed_uri
        )
    )

    for item in resolved_documents:

        doc_uri = item["document"]

        candidate = {

            "document": doc_uri,

            "document_label": str(
                g.value(
                    doc_uri,
                    RDFS.label
                )
                or doc_uri
            ),

            "reference": str(
                g.value(
                    doc_uri,
                    EX.sourceReference
                )
                or ""
            ),

            "content": get_document_content(
                doc_uri
            ),

            # Seed score is the initial graph evidence.
            "graph_score": float(
                seed["score"]
            ),

            "hop": 0,

            "root_seed": seed_uri,

            "evidence_source": seed_uri,

            "evidence_target": seed_uri,

            "predicate": None,

            "edge_strength": 0.0,

            "resolution": (
                "seed_"
                + item["resolution"]
            )
        }

        document_candidates[
            doc_uri
        ] = candidate


# ==========================================================
# 7. SECOND — ADD DOCUMENTS FROM GRAPH TRAVERSAL
#
# For every ranked relationship:
#
#     source ──predicate──> target
#
# check BOTH source and target nodes.
#
# This allows:
#
# Seed
#   ↓
# Node A
#   ↓
# Node B
#   ↓
# Document B
#
# to resolve correctly.
# ==========================================================

for edge in ranked_edges:

    graph_score = float(
        edge["graph_score"]
    )

    nodes_to_check = [

        (
            edge["source"],
            "source"
        ),

        (
            edge["target"],
            "target"
        )

    ]

    for node_uri, node_role in nodes_to_check:

        resolved_documents = (
            resolve_node_to_documents(
                node_uri
            )
        )

        for item in resolved_documents:

            doc_uri = item["document"]

            candidate = {

                "document": doc_uri,

                "document_label": str(
                    g.value(
                        doc_uri,
                        RDFS.label
                    )
                    or doc_uri
                ),

                "reference": str(
                    g.value(
                        doc_uri,
                        EX.sourceReference
                    )
                    or ""
                ),

                "content": get_document_content(
                    doc_uri
                ),

                "graph_score": graph_score,

                "hop": int(
                    edge["hop"]
                ),

                "root_seed": edge[
                    "root_seed"
                ],

                "evidence_source": edge[
                    "source"
                ],

                "evidence_target": edge[
                    "target"
                ],

                "predicate": edge[
                    "predicate"
                ],

                "edge_strength": float(
                    edge["strength"]
                ),

                "resolution": (
                    node_role
                    + "_"
                    + item["resolution"]
                )
            }

            # --------------------------------------------------
            # If the same document is reached multiple times,
            # keep the strongest graph evidence.
            # --------------------------------------------------

            if (
                doc_uri not in document_candidates
                or
                candidate["graph_score"]
                >
                document_candidates[
                    doc_uri
                ]["graph_score"]
            ):

                document_candidates[
                    doc_uri
                ] = candidate


# ==========================================================
# 8. SORT DOCUMENTS
# ==========================================================

retrieved_documents = sorted(

    document_candidates.values(),

    key=lambda x: (
        -x["graph_score"],
        x["hop"],
        -x["edge_strength"]
    )
)


# ==========================================================
# 9. SUMMARY
# ==========================================================

print()
print("=" * 80)
print("DOCUMENT RETRIEVAL SUMMARY")
print("=" * 80)

print(
    f"Seeds                    : "
    f"{len(seeds)}"
)

print(
    f"Ranked graph edges       : "
    f"{len(ranked_edges)}"
)

print(
    f"Unique documents retrieved: "
    f"{len(retrieved_documents)}"
)


