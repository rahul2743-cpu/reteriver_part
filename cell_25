import math
import pandas as pd
from collections import defaultdict, Counter

print("=" * 70)
print("CELL 25: QUERY-BASED CHUNK RANKING + MMR")
print("=" * 70)


# ============================================================
# 1. VALIDATION
# ============================================================

if "document_chunks" not in globals():
    raise RuntimeError(
        "document_chunks not found. Run Cell 24 first."
    )

if "query_info" not in globals():
    raise RuntimeError(
        "query_info not found. Run the query preprocessing cell first."
    )

if "tokenize" not in globals():
    raise RuntimeError(
        "tokenize() function not found."
    )

if document_chunks.empty:
    raise RuntimeError(
        "document_chunks is empty. No candidate chunks available."
    )

TOP_K = 10
MMR_LAMBDA = 0.75


# ============================================================
# 2. DETECT ACTUAL COLUMN NAMES FROM CELL 24
# ============================================================

print("\nColumns received from Cell 24:")
print(document_chunks.columns.tolist())


# ------------------------------------------------------------
# Document title column
# ------------------------------------------------------------

possible_title_columns = [
    "document_title",
    "doc_title",
    "source_title",
    "title",
    "document",
    "doc_name"
]

DOCUMENT_TITLE_COL = None

for col in possible_title_columns:
    if col in document_chunks.columns:
        DOCUMENT_TITLE_COL = col
        break


# ------------------------------------------------------------
# Chunk text column
# ------------------------------------------------------------

possible_chunk_columns = [
    "chunk_text",
    "text",
    "content",
    "chunk"
]

CHUNK_TEXT_COL = None

for col in possible_chunk_columns:
    if col in document_chunks.columns:
        CHUNK_TEXT_COL = col
        break


# ------------------------------------------------------------
# Check columns
# ------------------------------------------------------------

if DOCUMENT_TITLE_COL is None:
    raise RuntimeError(
        "Could not find document title column.\n"
        f"Available columns: {document_chunks.columns.tolist()}"
    )

if CHUNK_TEXT_COL is None:
    raise RuntimeError(
        "Could not find chunk text column.\n"
        f"Available columns: {document_chunks.columns.tolist()}"
    )


print(f"\nDocument title column : {DOCUMENT_TITLE_COL}")
print(f"Chunk text column     : {CHUNK_TEXT_COL}")


# ============================================================
# 3. QUERY
# ============================================================

original_query = query_info["original_query"]

query_tokens = set(
    tokenize(original_query)
)

print("\n" + "-" * 70)
print("QUERY")
print("-" * 70)

print(original_query)

print("\nQuery tokens:")
print(sorted(query_tokens))


# ============================================================
# 4. COPY CANDIDATE CHUNKS
# ============================================================

candidates = document_chunks.copy()

print("\n" + "-" * 70)
print("CANDIDATE CHUNKS")
print("-" * 70)

print(
    f"Candidate chunks received from Cell 24: "
    f"{len(candidates)}"
)

print(
    f"Candidate documents: "
    f"{candidates[DOCUMENT_TITLE_COL].nunique()}"
)


# ============================================================
# 5. CHUNK NUMBER
# ============================================================
#
# User-facing numbering starts from 1:
#
# Chunk 1
# Chunk 2
# ...
# Chunk 10
#
# Numbering restarts for each document.
# ============================================================

candidates["chunk_number"] = (
    candidates
    .groupby(DOCUMENT_TITLE_COL)
    .cumcount()
    + 1
)


# ============================================================
# 6. QUERY TOKEN COVERAGE
# ============================================================

def query_token_coverage(chunk_text, query_tokens):

    if not query_tokens:
        return 0.0

    chunk_tokens = set(
        tokenize(str(chunk_text))
    )

    matched_tokens = (
        query_tokens.intersection(chunk_tokens)
    )

    return (
        len(matched_tokens)
        /
        len(query_tokens)
    )


candidates["_query_coverage"] = (
    candidates[CHUNK_TEXT_COL]
    .apply(
        lambda x:
        query_token_coverage(
            x,
            query_tokens
        )
    )
)


# ============================================================
# 7. TERM FREQUENCY SCORE
# ============================================================

def chunk_term_score(chunk_text, query_tokens):

    if not query_tokens:
        return 0.0

    tokens = tokenize(
        str(chunk_text)
    )

    if not tokens:
        return 0.0

    token_counts = Counter(tokens)

    score = 0.0

    for term in query_tokens:

        tf = token_counts.get(
            term,
            0
        )

        score += tf

    # Normalize by chunk length
    score = (
        score /
        math.sqrt(len(tokens))
    )

    return score


candidates["_term_score"] = (
    candidates[CHUNK_TEXT_COL]
    .apply(
        lambda x:
        chunk_term_score(
            x,
            query_tokens
        )
    )
)


# ============================================================
# 8. NORMALIZE TERM SCORE
# ============================================================

max_term_score = (
    candidates["_term_score"].max()
)

if max_term_score > 0:

    candidates["_term_norm"] = (
        candidates["_term_score"]
        /
        max_term_score
    )

else:

    candidates["_term_norm"] = 0.0


# ============================================================
# 9. GRAPH SCORE
# ============================================================

if "graph_score" in candidates.columns:

    candidates["_graph_raw"] = (
        pd.to_numeric(
            candidates["graph_score"],
            errors="coerce"
        )
        .fillna(0.0)
    )

else:

    print(
        "\nWARNING: graph_score column not found."
    )

    candidates["_graph_raw"] = 0.0


max_graph_score = (
    candidates["_graph_raw"].max()
)

if max_graph_score > 0:

    candidates["_graph_norm"] = (
        candidates["_graph_raw"]
        /
        max_graph_score
    )

else:

    candidates["_graph_norm"] = 0.0


# ============================================================
# 10. QUERY SCORE
# ============================================================
#
# 60% Query token coverage
# 40% Term frequency
# ============================================================

candidates["_query_score"] = (
    0.60 *
    candidates["_query_coverage"]
    +
    0.40 *
    candidates["_term_norm"]
)


# ============================================================
# 11. FINAL RELEVANCE SCORE
# ============================================================
#
# 75% Query relevance
# 25% Graph evidence
# ============================================================

candidates["_score"] = (
    0.75 *
    candidates["_query_score"]
    +
    0.25 *
    candidates["_graph_norm"]
)


# ============================================================
# 12. TOKEN SET FOR MMR
# ============================================================

candidates["_tokens"] = (
    candidates[CHUNK_TEXT_COL]
    .apply(
        lambda x:
        set(tokenize(str(x)))
    )
)


# ============================================================
# 13. SORT CANDIDATES
# ============================================================

candidates = (
    candidates
    .sort_values(
        "_score",
        ascending=False
    )
    .reset_index(drop=True)
)


# ============================================================
# 14. DYNAMIC MAX_PER_DOC
# ============================================================

num_documents = (
    candidates[DOCUMENT_TITLE_COL]
    .nunique()
)

if num_documents <= 2:

    MAX_PER_DOC = 7

elif num_documents <= 4:

    MAX_PER_DOC = 5

else:

    MAX_PER_DOC = 3


print("\n" + "-" * 70)
print("DYNAMIC DOCUMENT LIMIT")
print("-" * 70)

print(
    f"Documents available : {num_documents}"
)

print(
    f"MAX_PER_DOC         : {MAX_PER_DOC}"
)


# ============================================================
# 15. JACCARD SIMILARITY
# ============================================================

def jaccard_similarity(
    tokens_a,
    tokens_b
):

    if not tokens_a or not tokens_b:
        return 0.0

    intersection = len(
        tokens_a.intersection(
            tokens_b
        )
    )

    union = len(
        tokens_a.union(
            tokens_b
        )
    )

    if union == 0:
        return 0.0

    return (
        intersection /
        union
    )


# ============================================================
# 16. GREEDY MMR
# ============================================================

remaining = candidates.copy()

chosen = []

per_doc = defaultdict(int)


while (
    len(chosen) < TOP_K
    and
    not remaining.empty
):

    best_index = None
    best_mmr = -float("inf")

    for idx, candidate in remaining.iterrows():

        document_title = (
            candidate[DOCUMENT_TITLE_COL]
        )

        # ----------------------------------------
        # MAX PER DOCUMENT
        # ----------------------------------------

        if (
            per_doc[document_title]
            >= MAX_PER_DOC
        ):
            continue


        # ----------------------------------------
        # REDUNDANCY
        # ----------------------------------------

        redundancy = 0.0

        if chosen:

            redundancy = max(
                jaccard_similarity(
                    candidate["_tokens"],
                    selected["_tokens"]
                )
                for selected in chosen
            )


        # ----------------------------------------
        # RELEVANCE
        # ----------------------------------------

        relevance = float(
            candidate["_score"]
        )


        # ----------------------------------------
        # MMR SCORE
        # ----------------------------------------

        mmr_score = (
            MMR_LAMBDA *
            relevance
            -
            (1 - MMR_LAMBDA) *
            redundancy
        )


        # ----------------------------------------
        # BEST CANDIDATE
        # ----------------------------------------

        if mmr_score > best_mmr:

            best_mmr = mmr_score

            best_index = idx


    # --------------------------------------------------------
    # No eligible candidate
    # --------------------------------------------------------

    if best_index is None:
        break


    # --------------------------------------------------------
    # Select candidate
    # --------------------------------------------------------

    selected = (
        remaining
        .loc[best_index]
        .copy()
    )

    selected["_mmr_score"] = (
        best_mmr
    )

    chosen.append(
        selected
    )


    document_title = (
        selected[DOCUMENT_TITLE_COL]
    )

    per_doc[document_title] += 1


    # Remove selected candidate
    remaining = (
        remaining
        .drop(index=best_index)
    )


# ============================================================
# 17. FINAL TOP-K
# ============================================================

if chosen:

    final_chunks = (
        pd.DataFrame(chosen)
        .reset_index(drop=True)
    )

    # Ranking starts from 1
    final_chunks["rank"] = (
        final_chunks.index + 1
    )

else:

    final_chunks = pd.DataFrame()


